# Секреты FinRadar. Скопируйте в .env (`finradar init`) — файл .env в git не попадает.

# Ваш контакт для User-Agent (хороший тон при сборе данных)
FINRADAR_CONTACT=

# hh.ru: токен приложения (если есть доступ к API); без него — режим HTML
HH_ACCESS_TOKEN=

# Telegram-бот для дайджестов: создать у @BotFather, chat_id — ваш id или id канала
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Опциональные API
SUPERJOB_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
REED_API_KEY=
JOOBLE_API_KEY=
RELIEFWEB_APPNAME=

# Почтовые алерты LinkedIn / Indeed / eFinancialCareers
IMAP_USER=
IMAP_PASSWORD=

# LLM-обогащение (finradar enrich)
ANTHROPIC_API_KEY=
