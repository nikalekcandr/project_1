{
  "name": "bizforge",
  "private": true,
  "version": "1.0.0",
  "description": "BizForge — лаборатория бизнес-идей: генерация, проверка, бизнес-модели, финмодель, Монте-Карло и бизнес-план",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && node scripts/build-single.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "react": "^19.1.9",
    "react-dom": "^19.1.9"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
